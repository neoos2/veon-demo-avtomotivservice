---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { NOTE } from "../data/site";
const cities = ["Дніпро", "Франківськ", "Львів", "Ворохта", "Ужгород", "Мукачево"];
---
<Section id="network" class="net">
  <div class="container">
    <h2>Мережа Avtomotiv Service з 2019 року</h2>
    <ul class="net__cities" aria-label="Міста мережі">
      {cities.map((c, i) => <li class:list={["num", c === "Львів" && "is-here"]} data-reveal style={`--reveal-delay:${i * 80}ms`}>{c}</li>)}
    </ul>
    <ul class="net__facts">
      <li><strong class="num">З 2019 року</strong> повний цикл обслуговування авто.</li>
      <li><strong class="num">160+ людей</strong> у команді мережі.</li>
      <li><strong class="num">Ba3a</strong> — окремий напрям для BMW і MINI.</li>
      <li><strong class="num">Telegram-бот</strong> — запис та історія обслуговування.</li>
    </ul>
    <p class="net__fl"><FutureLink note={NOTE}>Інші міста</FutureLink> <FutureLink note={NOTE}>Про мережу</FutureLink></p>
  </div>
</Section>
<style>
  :global(.net) { padding: var(--s-9) 0; background: var(--color-surface); }
  .net__cities { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); margin-top: var(--s-7); font-size: var(--fs-h3); color: var(--color-muted); }
  .net__cities .is-here { color: var(--color-text); box-shadow: inset 0 -3px 0 var(--color-brand); }
  .net__facts { display: grid; gap: var(--s-4); margin-top: var(--s-7); max-width: 60ch; }
  .net__facts strong { font-weight: 400; font-size: var(--fs-h3); display: block; }
  .net__fl { margin-top: var(--s-6); display: flex; gap: var(--s-5); flex-wrap: wrap; }
  @media (min-width: 1024px) {
    :global(.net) { padding: var(--s-9) 0 var(--s-10); }
    .net__cities { font-size: 44px; gap: var(--s-3) var(--s-6); }
    .net__facts { grid-template-columns: repeat(4, 1fr); max-width: none; gap: var(--s-5); }
  }
</style>
