---
import { PHONE_TEL, TG } from "../data/site";
---
<div class="bar on-dark" data-rec="UX-R004" role="region" aria-label="Швидкий зв'язок">
  <a class="btn btn--primary" href={PHONE_TEL}>Подзвонити</a>
  <a class="btn btn--outline" href={TG} target="_blank" rel="noopener noreferrer">Telegram</a>
</div>
<style>
  .bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; height: var(--bar-h); display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); padding: var(--s-3) var(--space); border-top: 1px solid var(--color-band-line); }
  .bar .btn { min-height: 48px; }
  @media (min-width: 768px) { .bar { display: none; } }
</style>
