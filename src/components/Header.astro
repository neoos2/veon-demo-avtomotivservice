---
import { NAV, PHONE_TEL, PHONE_TEXT, TG } from "../data/site";
---
<header class="hdr on-dark" id="site-header" data-rec="UX-R004,UX-R005,UX-R013">
  <div class="hdr__in container">
    <a class="hdr__logo" href="#top" aria-label="Avtomotiv Service, на початок сторінки"><img src="/logo-white.svg" width="200" height="34" alt="Avtomotiv Service" /></a>
    <span class="hdr__city">Львів</span>
    <nav class="hdr__nav" aria-label="Основна навігація">
      {NAV.map((n) => <a class="link" href={n.href} data-nav>{n.label}</a>)}
    </nav>
    <div class="hdr__act">
      <a class="hdr__tel num" href={PHONE_TEL}>{PHONE_TEXT}</a>
      <a class="btn btn--primary hdr__tg" href={TG} target="_blank" rel="noopener noreferrer">Telegram</a>
    </div>
    <details class="menu" id="menu">
      <summary class="menu__btn">Меню</summary>
      <div class="menu__panel">
        <nav aria-label="Меню">
          {NAV.map((n) => <a href={n.href} data-nav>{n.label}</a>)}
        </nav>
        <a class="menu__tel num" href={PHONE_TEL}>{PHONE_TEXT}</a>
      </div>
    </details>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; height: var(--header-h); transition: box-shadow 200ms; }
  .hdr.is-scrolled { box-shadow: 0 1px 0 var(--color-line); }
  .hdr__in { height: 100%; display: flex; align-items: center; gap: var(--s-5); }
  .hdr__logo { display: block; flex: none; line-height: 0; }
  .hdr__logo img { width: 132px; height: auto; }
  .hdr__city { display: none; color: var(--color-on-band-muted); font-size: var(--fs-small); }
  .hdr__nav, .hdr__act { display: none; }
  .menu { margin-left: auto; position: static; }
  .menu__btn { list-style: none; cursor: pointer; display: inline-flex; align-items: center; min-height: 48px; padding: 0 var(--s-4); border: 1.5px solid var(--color-on-band-muted); border-radius: var(--radius); font-weight: 600; }
  .menu__btn::-webkit-details-marker { display: none; }
  .menu__panel { position: absolute; left: 0; right: 0; top: var(--header-h); background: var(--color-band); padding: var(--s-4) var(--space) var(--s-6); display: grid; gap: var(--s-4); border-top: 1px solid var(--color-band-line); max-height: calc(100svh - var(--header-h)); overflow: auto; }
  .menu__panel nav { display: grid; }
  .menu__panel nav a { font: 400 var(--fs-h3)/1 var(--font-display); text-decoration: none; padding: var(--s-4) 0; border-bottom: 1px solid var(--color-band-line); }
  .menu__tel { white-space: nowrap; font-size: var(--fs-h3); text-decoration: none; }
  @media (min-width: 1100px) {
    .menu { display: none; }
    .hdr__logo img { width: 160px; }
    .hdr__city { display: block; }
    .hdr__nav { display: flex; gap: var(--s-5); margin-left: auto; font-size: var(--fs-small); font-weight: 600; }
    .hdr__act { display: flex; align-items: center; gap: var(--s-5); }
    .hdr__tel { font-size: 20px; text-decoration: none; white-space: nowrap; }
    .hdr__tg { min-height: 44px; padding: 0 var(--s-4); }
    .hdr__nav a[aria-current="true"] { color: var(--color-surface); box-shadow: inset 0 -2px 0 var(--color-brand); }
  }
</style>
<script>
  const header = document.getElementById("site-header")!;
  const menu = document.getElementById("menu") as HTMLDetailsElement;
  const onScroll = () => header.classList.toggle("is-scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true }); onScroll();
  menu.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu.open) { menu.open = false; (menu.querySelector("summary") as HTMLElement).focus(); } });
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => (menu.open = false)));
  // keep focus inside the open menu (summary + links + phone)
  menu.addEventListener("keydown", (e) => {
    if (e.key !== "Tab" || !menu.open) return;
    const f = [menu.querySelector("summary"), ...menu.querySelectorAll("a")] as HTMLElement[];
    const first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
  addEventListener("resize", () => { if (innerWidth >= 1100) menu.open = false; });
  // active anchor
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".hdr__nav [data-nav]")];
  const map = new Map(links.map((l) => [l.getAttribute("href")!.slice(1), l]));
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { links.forEach((l) => l.removeAttribute("aria-current")); map.get(e.target.id)?.setAttribute("aria-current", "true"); } });
    }, { rootMargin: "-40% 0px -55% 0px" });
    map.forEach((_, id) => { const s = document.getElementById(id); if (s) io.observe(s); });
  }
</script>
